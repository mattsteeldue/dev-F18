  36+ 6400              BACKSPACE_CHAR  equ     $08
  37+ 6400              CR_CHAR         equ     $0D
  38+ 6400              BLANK_CHAR      equ     $20
  39+ 6400              QUOTE_CHAR      equ     "'"
  40+ 6400              DQUOTE_CHAR     equ     '"'
  41+ 6400              UNDERSCORE_CHAR equ     $5F
  42+ 6400              SOLIDBLOCK_CHAR equ     $8F
  43+ 6400              HALFBLOCK_CHAR  equ     $8C
  44+ 6400              LC_A_CHAR       equ     $61                 // lower-case "a"
