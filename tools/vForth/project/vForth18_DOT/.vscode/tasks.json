{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            // use the sjasmplus assembler
            "label": "sjasmplus",
            "type": "shell",
            "command": "c:/Zx/sjasmplus/sjasmplus.exe",
            "args": [
                "--sld=${workspaceFolder}/list/main.sld.txt",
                "--fullpath",
                "--zxnext",
                "--lst=${workspaceFolder}/list/main.lst",
                "${workspaceFolder}/source/main.asm"
            ],
            "problemMatcher": []
        },
        {
            "label": "concat vforth",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd \"${workspaceFolder}\\output\" && copy vforth.1 /b + vforth.2 /b vforth /b"
            ],
            "problemMatcher": []
        },
        {
            "label": "build vforth",
            "dependsOrder": "sequence",
            "dependsOn": ["sjasmplus", "concat vforth"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}