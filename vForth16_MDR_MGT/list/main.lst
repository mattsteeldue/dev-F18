  24  0000              //  This is the complete compiler for v.Forth for SINCLAIR ZX Spectrum Next.
  25  0000              //  Each line of this source list mustn't exceed 80 bytes.
  26  0000              //  Z80N (ZX Spectrum Next) extension is available.
  27  0000              //
  28  0000              //  This list has been tested using the following configuration:
  29  0000              //      - CSpect emulator V.2.12.30
  30  0000              //  The binary-code "forth16.by" has to be manually copied to microdrive cartridge
  31  0000              //  via "F16.tap" tape file which contains such a binary file.
  32  0000              //  I'm using Z80 the Sinclair ZX Spectrum 48/128K Emulator Version 4.00 by Gerton Lunter 1999
  33  0000              //  ______________________________________________________________________
  34  0000              //
  35  0000              //  Z80 Registers usage map
  36  0000              //
  37  0000              //  AF
  38  0000              //  BC - Instruction Pointer: should be preserved during ROM/OS calls
  39  0000              //  DE - Working
  40  0000              //  HL - Working
  41  0000              //
  42  0000              //  AF'- Sometime used for backup purpose
  43  0000              //  BC'- Not used
  44  0000              //  DE'- Not used
  45  0000              //  HL'- Not used: (saved at startup)
  46  0000              //
  47  0000              //  SP - Calculator Stack Pointer
  48  0000              //  IX - Inner interpreter "next" address pointer. This way jp (ix) is 2T-state faster than JP next
  49  0000              //  IY - (ZX System: must be preserved to interact with standard ROM)
  50  0000              //
  51  0000              //  ______________________________________________________________________
  52  0000              //
  53  0000              //  _________________
  54  0000              //
  55  0000              //  FORTH DEFINITIONS
  56  0000              //  _________________
  57  0000
  58  0000              //              OPT     --zxnext
  59  0000              //  ______________________________________________________________________
  60  0000              //
  61  0000              // this controls some debugging code in L0.asm
  62  0000              //  0 for final binary release.
  63  0000              //  1 for debugging with Visual Studio Code and DeZog
  64  0000              // -1 for for binary comparison with Forth generated code.
  65  0000              DEBUGGING       equ     0
  66  0000              //
  67  0000              //  ______________________________________________________________________
  68  0000
  69  0000                              if ( -1 == DEBUGGING )
  70  0000 ~            ORIGIN          equ    41980 - $80                    // for binary comparison
  71  0000 ~            //ORIGIN          equ     $8CC1                   // for binary comparison
  72  0000                              endif
  73  0000              //  ______________________________________________________________________
  74  0000
  75  0000                              if (  0 == DEBUGGING )
  76  0000              ORIGIN          equ     $6400                   // binary and Tape
  77  0000                              endif
  78  0000              //  ______________________________________________________________________
  79  0000
  80  0000                              if (  1 == DEBUGGING )
  81  0000 ~            ORIGIN          equ     $8080                   // for DeZog
  82  0000                              endif
  83  0000              //  ______________________________________________________________________
  84  0000
  85  0000                            DEVICE  ZXSPECTRUM48
  86  0000
  87  0000                              ORG     ORIGIN
