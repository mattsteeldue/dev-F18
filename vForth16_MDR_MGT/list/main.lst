  51+ 6400                              // emulate something like:  ld hl,rp
  52+ 6400              ldhlrp          macro
  53+ 6400 ~                            ld      hl,(RP_Pointer)
  54+ 6400                              endm
  55+ 6400
  56+ 6400                              // emulate something like:  ld rp,hl
  57+ 6400              ldrphl          macro
  58+ 6400 ~                            ld      (RP_Pointer),hl
  59+ 6400                              endm
  60+ 6400
  61+ 6400              //  ______________________________________________________________________
  62+ 6400              //
  63+ 6400              //  Inner interpreter next-address pointer. This is 2T-state faster than "jp address"
  64+ 6400              next            macro
  65+ 6400 ~                            jp      (ix)
  66+ 6400                              endm
  67+ 6400
  68+ 6400              psh1            macro
  69+ 6400 ~                            push    hl
  70+ 6400 ~                            jp      (ix)
  71+ 6400                              endm
  72+ 6400
  73+ 6400              psh2            macro
  74+ 6400 ~                            push    de
  75+ 6400 ~                            push    hl
  76+ 6400 ~                            jp      (ix)
  77+ 6400                              endm
  78+ 6400
  79+ 6400              //  ______________________________________________________________________
  80+ 6400              //
  81+ 6400              // Bit constants in length-byte
  82+ 6400
  83+ 6400              SMUDGE_BIT      equ     %00100000               // $20
  84+ 6400              IMMEDIATE_BIT   equ     %01000000               // $40
  85+ 6400              END_BIT         equ     %10000000               // $80
  86+ 6400
  87+ 6400
  88+ 6400              //  ______________________________________________________________________
  89+ 6400              //
  90+ 6400              //  To create Forth words using this (nice) Assembler, we have to use the two following
  91+ 6400              //  pointers
  92+ 6400              temp_NFA        defl    0
  93+ 6400              last_NFA        defl    0
  94+ 6400              len_NFA         defl    0
  95+ 6400
  96+ 6400              is_code         equ     0                   // so the direct machine-code starts at CFA
  97+ 6400              is_normal       equ     0                   // so the direct machine-code starts at CFA
  98+ 6400              is_immediate    equ     IMMEDIATE_BIT       // $40 - the definition is IMMEDIATE.
  99+ 6400
 100+ 6400              //  ______________________________________________________________________
 101+ 6400              //
 102+ 6400              //  Create a new "low-level" definition
 103+ 6400              //  This macro is used in the form  Create FORTH_NAME,n,"forth_name"
 104+ 6400              //  to create a new Forth Dictionary entry the same way Forth itself would do.
 105+ 6400              //  A word begins with a Length-Byte in range 1-31. Top 3 msb are used as flags
 106+ 6400              //  see SMUDGE_BIT and IMMEDIATE_BIT constant above.
 107+ 6400              //  It is followed by the Name of the word, i.e. a string expressed in 7-bit Ascii.
 108+ 6400              //  The last character of the Name must have the msb set to signal the end of it (END_BIT)
 109+ 6400              //  This macro acts much like the standard Forth definition CREATE
 110+ 6400
 111+ 6400              New_Def         macro   label, namec, runcode, bits
 112+ 6400 ~            temp_NFA        defl    $                   // save this NFA address to temp_NFA
 113+ 6400 ~
 114+ 6400 ~                            // dummy db directives used to calculate length of namec
 115+ 6400 ~                            db      namec
 116+ 6400 ~            len_NFA         defl    $ - temp_NFA
 117+ 6400 ~                            org     $ - len_NFA         // rewind to temp_NFA and re-do NFA part
 118+ 6400 ~
 119+ 6400 ~                            db      len_NFA | END_BIT | bits  // The start of NFA must have msb set to signal the beginning of the sounted string
 120+ 6400 ~                            db      namec               // name string in 7-bit ascii, but
 121+ 6400 ~                            org     $-1                 // alter last byte of Name just above to set
 122+ 6400 ~                            db      {b $} | END_BIT     // msb as name end
 123+ 6400 ~
 124+ 6400 ~                            dw      last_NFA            // Link to previous definition Name
 125+ 6400 ~            label:          if runcode != 0 ; ok        // This is the start address of the direct jp(hl)
 126+ 6400 ~                            call    runcode ; ok        // for primitive definitions  actual code
 127+ 6400 ~
 128+ 6400 ~
 129+ 6400 ~                            endif           ; ok        // for other definitions it "points" the correct handler
 130+ 6400 ~                            // Use of "; ok" to suppress "warning[fwdref]"
 131+ 6400 ~
 132+ 6400 ~            last_NFA        defl    temp_NFA            // keep track of NFA saved above
 133+ 6400                              endm
 134+ 6400
 135+ 6400              //  ______________________________________________________________________
 136+ 6400              //
 137+ 6400              // Create a "constant"
 138+ 6400              // The constant value is compiled in first PFA cell
 139+ 6400              Constant_Def    macro   label, namec, constant_value
 140+ 6400 ~                            New_Def  label, namec, Constant_Ptr, is_normal
 141+ 6400 ~                            dw      constant_value
 142+ 6400                              endm
 143+ 6400
 144+ 6400              //  ______________________________________________________________________
 145+ 6400              //
 146+ 6400              // Create a "variable"
 147+ 6400              // The when invoked, a variable returns a pointer, the address of first PFA cell
 148+ 6400              // this allow creation of "variables" which content is  of any length
 149+ 6400              Variable_Def    macro   label, namec, initial_value
 150+ 6400 ~                            New_Def  label, namec, Variable_Ptr, is_normal
 151+ 6400 ~                            dw      initial_value
 152+ 6400                              endm
 153+ 6400
 154+ 6400              //  ______________________________________________________________________
 155+ 6400              //
 156+ 6400              // Create a "user"
 157+ 6400              // It uses a single byte as offset to calculate the address of the variable
 158+ 6400              User_Def        macro   label, namec, offset_value
 159+ 6400 ~                            New_Def  label, namec, User_Ptr, is_normal
 160+ 6400 ~                            db      offset_value
 161+ 6400                              endm
 162+ 6400
 163+ 6400              //  ______________________________________________________________________
 164+ 6400              //
 165+ 6400              // Create a "colon-definition"
 166+ 6400              // The CFA contains a small routine i.e. "call Enter_Ptr".
 167+ 6400              // The PFA, three bytes later, contains the actual Forth definition
 168+ 6400              Colon_Def       macro   label, namec, bits
 169+ 6400 ~                            New_Def  label, namec, Enter_Ptr, bits ; ok
 170+ 6400                              endm
 171+ 6400
 172+ 6400              //  ______________________________________________________________________
 173+ 6400              //
 174+ 6400
 175+ 6400              LIMIT_system:   equ     $FF58               // Address of first byte beyond last BUFFER
 176+ 6400              BUFFERS         equ     6                   // number of buffers available. must be the difference between LIMIT and FIRST divided by 516
 177+ 6400              FIRST_system:   equ     LIMIT_system - 516*BUFFERS // Address of first BUFFER
 178+ 6400              USER_system:    equ     FIRST_system - 80   // User variables zone.
 179+ 6400              R0_system:      equ     USER_system         // Address of top of Return Stack. This is S0 + $00A0
 180+ 6400              TIB_system      equ     R0_system - 160     // TIB grows upwards, Return-Stack downward.
 181+ 6400              S0_system:      equ     TIB_system          // Address of top of Calc Stack
 182+ 6400
