  89  6400                              if ( -1 == DEBUGGING )
  90  6400 ~                            ds 128                            // for binary comparison
  91  6400                              endif
  92  6400
  93  6400              //  ______________________________________________________________________
  94  6400              //
  95  6400              //  Naming convention for Label vs Forth correspondance
  96  6400              //  Forth words are named as they are named for real with some exception to avoid assembler syntax errors.
  97  6400              //    - Leading "0" is converted into "Z_"
  98  6400              //    - Leading "(" is converted into "C_", closing bracket is omitted
  99  6400              //    - Leading numbers are converted in letters: ONE_  TWO_ etc.
 100  6400              //    - Question mark "?" is converted into "Q" or omitted if needed / useful.
 101  6400              //    - Plus sign "+" is converted in _PLUS or ADD_ depending.
 102  6400              //    - Minus sign "-" in L (for Line), MINUS or SUBTRACT depending
 103  6400              //    - Greater-Than sign ">" in _GREATER or TO_ depending
 104  6400              //    - Equal sign "=" is converted in EQUAL
 105  6400              //    - Less-Than sign "<" in _LESS or FROM_ (or TO_ again) depending
 106  6400              //    - Asterisk sign "*" is converted in _MUL or STAR
 107  6400              //    - Slash "/" is converted in _DIV or omitted if it is clear what it means
 108  6400              //    - Exclamation mark "!" is converted in STORE
 109  6400              //    - At-Sign "@" is converted in FETCH
 110  6400              //    - Words that collide with Assembler are normally suffixed with "_OP"
 111  6400
 112  6400                              include "system.asm"
